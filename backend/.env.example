# Consumo Energia 2.0 — variáveis de ambiente do backend
# Copie para .env e preencha com valores reais. Nunca commite o .env.

# Porta do servidor (padrão: 10000)
PORT=10000

# OBRIGATÓRIO: conexão PostgreSQL (o servidor não sobe sem ela)
DATABASE_URL=postgres://usuario:senha@localhost:5432/consumo_energia

# OBRIGATÓRIO: segredo usado para assinar os JWTs (o servidor não sobe sem ele)
JWT_SECRET=troque-por-um-segredo-forte

# Origem(s) do frontend permitidas por CORS — uma ou mais, separadas por vírgula
FRONTEND_URL=http://localhost:5500

# Rate limit dos endpoints de autenticação por IP (requisições por minuto).
# A contagem fica na tabela auth_rate_limit, provisionada pela migração
# backend/migrations/001_auth_rate_limit.sql — em serverless, um contador em memória não vale entre instâncias.
RATE_LIMIT_PER_MINUTE=10

# TLS da conexão com o Postgres. Em produção o padrão é 'verify', que exige
# certificado válido. Use 'no-verify' apenas se souber o motivo: ela criptografa
# o tráfego mas não confere quem está do outro lado. 'disable' é para
# desenvolvimento local e para o CI.
# DATABASE_SSL_MODE=verify

# Certificado da autoridade do provedor, em PEM, quando ele não usa uma CA
# pública. Só é lido no modo 'verify'.
# DATABASE_CA_CERT=

# Trust only verified proxy hops. 0 ignores forwarded headers (safe default).
TRUST_PROXY_HOPS=0
